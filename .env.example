# Configuración del servidor
PORT=8080
GIN_MODE=debug

# Configuración de la base de datos
DB_TYPE=sqlite
DB_NAME=tasks.db

# Para PostgreSQL (descomenta y configura si lo usas)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=tasks_db
# DB_SSLMODE=disable

# CORS - Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API
API_VERSION=v1
